# Repo-wide rules. Project-specific rules live in app/.gitignore and web/.gitignore.

# Secrets: never commit environment files (keep the *.example templates)
.env
.env.*
**/.env
**/.env.*
!.env.example
!**/.env.example

# OS / editor
.DS_Store
*.log
*.swp
.idea/
*.iml
*.ipr
*.iws

# Node / Next.js
node_modules/
.next/
.vercel/

# Signing keys and their passwords: never commit (the Play upload key cannot be replaced casually)
*.jks
*.keystore
key.properties
**/key.properties
