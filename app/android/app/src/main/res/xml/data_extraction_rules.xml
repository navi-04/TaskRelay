<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: never back up or transfer the keystore-wrapped session, the alarm store, the action log, the cache or the app
     blocker settings (the blocked-app list is device-local by design).
     The AndroidKeyStore key does not survive a restore, so a restored session would be undecryptable anyway. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="taskrelay_session.xml" />
        <exclude domain="sharedpref" path="taskrelay_blocker.xml" />
        <exclude domain="file" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="taskrelay_session.xml" />
        <exclude domain="sharedpref" path="taskrelay_blocker.xml" />
        <exclude domain="file" path="." />
    </device-transfer>
</data-extraction-rules>
